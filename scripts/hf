#!/usr/bin/env bash
# Run the pinned HyperFrames CLI with its network side effects disabled:
# no skill self-updates, no telemetry, no update checks, and the local
# headless Chromium instead of a downloaded Chrome.
set -euo pipefail
export HYPERFRAMES_SKIP_SKILLS=1
export HYPERFRAMES_NO_TELEMETRY=1
export DO_NOT_TRACK=1
export HYPERFRAMES_NO_UPDATE_CHECK=1
export HYPERFRAMES_BROWSER_PATH="${HYPERFRAMES_BROWSER_PATH:-/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell}"
export PRODUCER_HEADLESS_SHELL_PATH="${PRODUCER_HEADLESS_SHELL_PATH:-$HYPERFRAMES_BROWSER_PATH}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$root/node_modules/.bin/hyperframes" "$@"
